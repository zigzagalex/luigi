# Copy to luigi-mvp/.env. Compose reads that file from this directory.
# Shop and admin dev servers read web-shop/.env.local and web-admin/.env.local
# (see those apps' .env.example). Defaults below match a laptop with no extra config.

ENV=dev

POSTGRES_DB=luigi
POSTGRES_USER=luigi
POSTGRES_PASSWORD=luigi
# Host port. Containers always talk to Postgres on 5432.
POSTGRES_PORT=5432

# For tools on the host (goose, seedadmin, go run). Compose services build their own URL.
DATABASE_URL=postgres://luigi:luigi@localhost:5432/luigi?sslmode=disable

# Required by the API. Fine for a laptop; replace before the process is reachable by anyone else.
SESSION_SECRET=dev-only-session-secret-change-me

# Browser origins allowed to call the API with cookies. Shop is :3000, admin is :3001.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Public origin for image URLs. Next dev serves web-shop/public until uploads go to SeaweedFS.
MEDIA_BASE_URL=http://localhost:3000

# SeaweedFS S3. Inside Compose the API uses http://seaweedfs:8333.
# The host publishes S3 only (default :8333) for browser GETs.
S3_ENDPOINT=http://seaweedfs:8333
S3_PORT=8333
S3_BUCKET=luigi
S3_ACCESS_KEY=luigi
S3_SECRET_KEY=luigi-dev-secret
S3_REGION=us-east-1

# One shop per deploy. The seed service creates this id when it is missing.
# Frontends must use the same value as NEXT_PUBLIC_SHOP_ID.
SHOP_ID=1

SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Local Admin
SEED_ADMIN_PHONE=+41000000000
