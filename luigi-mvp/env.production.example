# Copy to /opt/luigi/.env and chmod 600.
# Generate secrets with: openssl rand -hex 32
# Hex avoids characters that break the Postgres URL.
#
# GHCR_OWNER is the GitHub user or org, lowercase.
# GITHUB_REPOSITORY is owner/repo, used to check image signatures.
# API_TAG, SHOP_TAG, and ADMIN_TAG are full git SHAs. deploy.sh writes them.
# Leave them empty until the first successful deploy has built all three images,
# or set them to that first sha yourself.

GHCR_OWNER=
GITHUB_REPOSITORY=

API_TAG=
SHOP_TAG=
ADMIN_TAG=

ACME_EMAIL=
SHOP_DOMAIN=
ADMIN_DOMAIN=
MEDIA_DOMAIN=

POSTGRES_USER=luigi
POSTGRES_PASSWORD=
POSTGRES_DB=luigi

SESSION_SECRET=
S3_BUCKET=luigi
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

SHOP_ID=1
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=+41000000000
